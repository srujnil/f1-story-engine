# F1 Story Engine — environment variables
# Copy to .env.local and fill in when needed. Nothing here is required for v0
# (mock data only, no network calls). Never commit .env.local.

# Jolpica F1 API (free, no key required) — planned for Step 6, real data integration.
# https://github.com/jolpica/jolpica-f1
NEXT_PUBLIC_F1_API_BASE_URL=https://api.jolpi.ca/ergast/f1

# Supabase (only if/when we add persistence — not used in the MVP)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
