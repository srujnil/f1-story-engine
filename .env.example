# F1 Story Engine — environment variables
# Copy to .env.local only if you need to override a default. Never commit
# .env.local.

# Jolpica F1 API (free, no key required). Server-only so we can send the custom
# User-Agent required by Jolpica without exposing integration details to browsers.
# https://github.com/jolpica/jolpica-f1
F1_API_BASE_URL=https://api.jolpi.ca/ergast/f1

# OpenF1 historical session enrichment (free after the live-session window).
# Used server-side for race control, tyre stints, pit stops, and race results.
OPENF1_API_BASE_URL=https://api.openf1.org/v1

# Supabase — required for Community Paddock (auth + persistence). Get these
# from your project's Settings → API. NEXT_PUBLIC_SUPABASE_ANON_KEY accepts
# either the legacy anon key or the newer "publishable key" — same slot.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
